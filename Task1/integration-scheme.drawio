        </mxCell>
        <mxCell id="c79" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="Толстая линия — интеграция через БД" vertex="1">
          <mxGeometry height="22" width="470" x="2240" y="382" as="geometry" />
        </mxCell>
        <mxCell id="c80" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#eef4fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Процесс открытия депозита (AS-IS)&lt;/b&gt;&lt;br&gt;Кредитование ежедневно считает ставки в Excel и шлёт файл в бэк-офис депозитов по e-mail.&lt;br&gt;Звонок в КЦ → обращение в системе КЦ → заявка в АБС → бэк-офис заранее ставит ставку → АБС шлёт SMS через СМС-шлюз и телеком-оператора.&lt;br&gt;Визит без звонка → фронт-офис запрашивает ставку у бэк-офиса по e-mail.&lt;br&gt;Спецставка: депозиты ↔ кредитование по e-mail, анализ риска в АБС, расчёт в Excel (до 1 часа).&lt;br&gt;Фронт-офис создаёт депозит в АБС, печатает документы, загружает подписанные в АБС." vertex="1">
          <mxGeometry height="118" width="520" x="2190" y="422" as="geometry" />
        </mxCell>
        <mxCell id="c81" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#eef8f0;strokeColor=#2d8a4e;" value="&lt;b&gt;Кредитный процесс (AS-IS)&lt;/b&gt;&lt;br&gt;Заявка только в отделении: менеджер вводит её в АБС.&lt;br&gt;АБС → Кредитный конвейер: через БД раз в сутки.&lt;br&gt;Сотрудник кредитования рассматривает заявку в конвейере; конвейер вызывает скоринг по REST API; скоринг онлайн запрашивает БКИ, а данные клиентов и платежей из АБС и номера платежей из конвейера получает через БД раз в сутки. Решение принимает сотрудник.&lt;br&gt;Одобренные заявки раз в сутки через БД уходят в АБС, где средства зачисляются на счёт.&lt;br&gt;Срок рассмотрения — около недели." vertex="1">
          <mxGeometry height="130" width="520" x="2190" y="550" as="geometry" />
        </mxCell>
        <mxCell id="c82" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fcf0f0;strokeColor=#b85450;" value="&lt;b&gt;Ключевые проблемы интеграции&lt;/b&gt;&lt;br&gt;• У АБС нет API: интернет-банк, конвейер и скоринг работают с её БД напрямую.&lt;br&gt;• Пакетные обмены раз в сутки не дают принять кредитное решение за 1 день.&lt;br&gt;• Ставки и спецставки живут в Excel и e-mail — их нельзя вызвать из интернет-банка.&lt;br&gt;• Сайт и партнёрский КЦ не интегрированы с системами банка." vertex="1">
          <mxGeometry height="90" width="520" x="2190" y="690" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
