<mxfile host="app.diagrams.net" type="device"><diagram id="C4 Component — заявка на кредит онлайн" name="C4 Component — заявка на кредит онлайн"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2740" pageHeight="1542" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;[Component] Банк «Стандарт» — заявка на кредит онлайн&lt;/b&gt;&lt;br&gt;C4, уровень 3: компоненты Кредитного конвейера и системы скоринга; каналы и интеграции показаны контейнерами" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2700" height="46" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Новый клиент&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Person]&lt;/i&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="150" height="130" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Клиент банка&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Person]&lt;/i&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="150" height="130" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Каналы: сайт и интернет-банк&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;fontColor=#333333;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="230" y="80" width="600" height="1100" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Сайт&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Container: PHP, React]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Условия кредитов, заявка, паспорт и согласие на БКИ, ожидание решения' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#2A9D8F;strokeColor=#1E7066;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="120" width="240" height="115" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Микрофронтенд «Кредиты»&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Container: React, UI-кит]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Условия, предодобренное предложение, быстрая заявка, статус' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="460" width="240" height="115" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Container: .NET 8, YARP (MVP)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Новые маршруты /credit, rate limit, CAPTCHA' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#2A9D8F;strokeColor=#1E7066;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="290" width="240" height="115" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Сервис кредитных предложений&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Container: .NET 8, MS SQL]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Витрина условий кредитов и предодобренных предложений' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="460" width="240" height="115" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Сервис кредитных заявок&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Container: .NET 8, MS SQL]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Заявки, согласия на БКИ, статусы, идемпотентность, запросы на СМС' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="680" width="240" height="115" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;OTP-сервис&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Container: .NET 8 (MVP)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;СМС-код для подтверждения заявки' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="680" width="240" height="115" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;Сервис уведомлений&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Container: .NET 8 (MVP)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Отправка СМС через СМС-шлюз' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="900" width="240" height="115" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;СМС-шлюз → Телеком-оператор&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Software System]&lt;/i&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="260" y="1220" width="240" height="80" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;Apache Kafka&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Container (MVP)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Новые топики:&lt;br&gt;credit.applications&lt;br&gt;credit.application-statuses&lt;br&gt;credit.products&lt;br&gt;credit.preapproved-offers&lt;br&gt;&lt;br&gt;Существующий:&lt;br&gt;notification.sms' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#2A9D8F;strokeColor=#1E7066;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="890" y="290" width="190" height="640" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Кредитный конвейер&lt;/b&gt; [Container: Camunda BPM, Java, Oracle]" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;fontColor=#333333;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1140" y="80" width="1040" height="610" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;Online Application Listener&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Component: Spring Kafka]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Читает credit.applications, запускает процесс по ключу заявки' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1170" y="130" width="240" height="115" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b&gt;Процесс «Предварительное решение»&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Component: BPMN + DMN]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Новый клиент: скоринг по БКИ, правила DMN, автоматическое предварительное решение' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1460" y="130" width="240" height="115" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;Application Matcher&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Component: Java, Camunda message correlation]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Связывает заявку из суточного обмена АБС с онлайн-заявкой по ID и паспорту' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1750" y="130" width="240" height="115" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;Status Publisher&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Component: Camunda listener, Spring Kafka]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Публикует смену статуса заявки в credit.application-statuses' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1170" y="330" width="240" height="115" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b&gt;Процесс «Быстрая заявка»&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Component: BPMN]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Предодобренное предложение: упрощённый скоринг, задача сотруднику в тот же день' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1460" y="330" width="240" height="115" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b&gt;Tasklist сотрудника&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Component: Camunda Tasklist (существующий)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Новое: очередь быстрых заявок с приоритетом и сроком «в тот же день»' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#A8D5C6;strokeColor=#2A9D8F;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1750" y="330" width="240" height="115" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b&gt;Products Publisher&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Component: Spring Kafka]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Публикует условия кредитных продуктов в credit.products' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1170" y="530" width="240" height="115" as="geometry"/></mxCell><mxCell id="c23" value='&lt;b&gt;Scoring Client&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Component: Java, Resilience4j]&lt;/i&gt;&lt;br&gt;&lt;br&gt;REST-вызов скоринга: тайм-аут, лимит запросов, повтор' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1460" y="530" width="240" height="115" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b&gt;Сотрудник кредитования&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Person]&lt;/i&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="2230" y="480" width="150" height="130" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Система кредитного скоринга&lt;/b&gt; [Container: Python, Flask, PostgreSQL]" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;fontColor=#333333;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1140" y="760" width="1040" height="420" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;Batch Precompute Job&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Component: Python, cron]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Ночной расчёт предодобренных сумм на отдельном экземпляре по копии данных' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1170" y="810" width="240" height="115" as="geometry"/></mxCell><mxCell id="c27" value='&lt;b&gt;Online Scoring API&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Component: Flask REST]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Режимы: полный, новый клиент (только БКИ), упрощённый повторный; лимит запросов онлайн-каналов' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#A8D5C6;strokeColor=#2A9D8F;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1460" y="810" width="240" height="115" as="geometry"/></mxCell><mxCell id="c28" value='&lt;b&gt;ML Model&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Component: Python (существующий)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Расчёт рейтинга клиента' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#D9D9D9;strokeColor=#8C8C8C;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1750" y="810" width="240" height="115" as="geometry"/></mxCell><mxCell id="c29" value='&lt;b&gt;Offer Publisher&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Component: confluent-kafka]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Публикует предодобренные предложения в credit.preapproved-offers' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1170" y="1010" width="240" height="115" as="geometry"/></mxCell><mxCell id="c30" value='&lt;b&gt;Реплика БД скоринга&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Container: PostgreSQL]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Данные клиентов и платежей (суточная загрузка из АБС и конвейера)' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=10;spacing=4;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1460" y="1000" width="240" height="135" as="geometry"/></mxCell><mxCell id="c31" value='&lt;b&gt;BKI Client&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Component: requests (существующий)]&lt;/i&gt;&lt;br&gt