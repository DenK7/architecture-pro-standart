<mxfile host="app.diagrams.net" type="device"><diagram id="C4 Context — заявка на кредит онлайн" name="C4 Context — заявка на кредит онлайн"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;[System Context] Банк «Стандарт» — заявка на кредит онлайн (сайт и интернет-банк)&lt;/b&gt;&lt;br&gt;C4, уровень 1. Показаны только элементы, которые затрагивает изменение" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2000" height="46" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Новый клиент&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Ещё не клиент банка, приходит с сайта' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="110" y="80" width="170" height="150" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Клиент банка&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Пользователь интернет-банка' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="170" height="150" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Сотрудник отделения&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Идентифицирует клиента, продолжает заявку' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="1500" y="80" width="170" height="150" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Сотрудник кредитования&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Принимает решение по заявке' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="1080" y="80" width="170" height="150" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Сайт&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Software System: PHP, React]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Кредитные предложения, заявка: Ф. И. О., телефон, по желанию паспорт и согласие на запрос в БКИ' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#2A9D8F;strokeColor=#1E7066;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="310" height="160" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Интернет-банк&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Software System: монолит + сервисы .NET 8 (MVP)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Новое: микрофронтенд «Кредиты», сервисы кредитных предложений и заявок; предодобренное предложение, быстрая заявка с OTP, статус' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#2A9D8F;strokeColor=#1E7066;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="480" y="340" width="330" height="160" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Интеграционная платформа&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Software System: Kafka, Kafka Connect, сервис уведомлений (MVP)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Новое: топики кредитных заявок, статусов, условий и предодобренных предложений' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#2A9D8F;strokeColor=#1E7066;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="480" y="640" width="330" height="160" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Кредитный конвейер&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Software System: Camunda BPM, Java, Oracle]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Новое: приём онлайн-заявок из Kafka, процессы предварительного решения и быстрой заявки, публикация статусов и условий' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#2A9D8F;strokeColor=#1E7066;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1000" y="340" width="330" height="160" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Система кредитного скоринга&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Software System: Python, Flask, PostgreSQL, ML]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Новое: скоринг нового клиента по данным БКИ, упрощённый повторный скоринг, ночной предрасчёт предодобренных предложений' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#2A9D8F;strokeColor=#1E7066;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1000" y="640" width="330" height="160" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;Бюро кредитных историй&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[External System]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Кредитная история по REST API' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#6B6B6B;strokeColor=#4D4D4D;fontColor=#ffffff;dashed=1;" vertex="1" parent="1"><mxGeometry x="1000" y="920" width="330" height="120" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;АБС&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Software System: Delphi, Oracle, PL/SQL]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Новое: предварительные заявки с сайта для отделения. Суточный обмен с конвейером — без изменений' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#2A9D8F;strokeColor=#1E7066;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1460" y="340" width="330" height="160" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;СМС-шлюз → Телеком-оператор&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Software System + External System]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Доставка СМС клиенту' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="310" height="110" as="geometry"/></mxCell><mxCell id="c15" value="UC1–UC3: условия,&lt;br&gt;заявка [HTTPS]" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;fontColor=#5A5A5A;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="UC1, UC6, UC8: предложение,&lt;br&gt;быстрая заявка, статус [HTTPS]" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;fontColor=#5A5A5A;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="UC4, UC7: рассматривает&lt;br&gt;заявки [Web UI]" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;fontColor=#5A5A5A;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="UC4: продолжает заявку&lt;br&gt;с сайта [Delphi]" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;fontColor=#5A5A5A;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="UC1–UC3&lt;br&gt;[REST через&lt;br&gt;API Gateway]" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;fontColor=#5A5A5A;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="UC2, UC3, UC6: заявки →&lt;br&gt;← UC1, UC5, UC8: условия,&lt;br&gt;предложения, статусы" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#D9822B;fontColor=#D9822B;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="UC2, UC3, UC6: заявки →&lt;br&gt;← UC1, UC8: условия, статусы" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#D9822B;fontColor=#D9822B;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;startArrow=block;startFill=1;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="664"/><mxPoint x="900" y="452"/></Array></mxGeometry></mxCell><mxCell id="c22" value="UC5: предодобренные&lt;br&gt;предложения" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#D9822B;fontColor=#D9822B;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="UC3, UC7: запрос&lt;br&gt;скоринга [REST]" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;fontColor=#5A5A5A;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="UC3, UC5, UC7: кредитная&lt;br&gt;история [REST]" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;fontColor=#5A5A5A;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry x="0.55" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="UC4: заявки с сайта для отделения [Kafka Connect]" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#D9822B;fontColor=#D9822B;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c9" target="c13"><mxGeometry x="0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="645" y="860"/><mxPoint x="1625" y="860"/></Array></mxGeometry></mxCell><mxCell id="c26" value="UC4: раз в&lt;br&gt;сутки [БД]" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;fontColor=#5A5A5A;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="UC8: СМС о статусах [HTTP]" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;fontColor=#5A5A5A;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c9" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="760"/><mxPoint x="420" y="955"/></Array></mxGeometry></mxCell><mxCell id="c28" value="UC2, UC8: СМС" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;fontColor=#5A5A5A;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=0.1;entryY=0.9;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c14" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="102" y="860"/><mxPoint x="20" y="860"/><mxPoint x="20" y="215"/></Array></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;Легенда&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1460" y="880" width="300" height="24" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1460" y="910" width="40" height="22" as="geometry"/></mxCell><mxCell id="c31" value="Новый элемент" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1510" y="910" width="300" height="22" as="geometry"/></mxCell><mxCell id="c32" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#2A9D8F;strokeColor=#1E7066;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1460" y="940" width="40" height="22" as="geometry"/></mxCell><mxCell id="c33" value="Существующий элемент, дорабатывается" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1510" y="940" width="300" height="22" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1460" y="970" width="40" height="22" as="geometry"/></mxCell><mxCell id="c35" value="Существующий элемент без изменений" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1510" y="970" width="300" height="22" as="geometry"/></mxCell><mxCell id="c36" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#6B6B6B;strokeColor=#4D4D4D;fontColor=#ffffff;dashed=1;" vertex="1" parent="1"><mxGeometry x="1460" y="1000" width="40" height="22" as="geometry"/></mxCell><mxCell id="c37" value="Внешняя система" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1510" y="1000" width="300" height="22" as="geometry"/></mxCell><mxCell id="c38" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1460" y="1041" width="1" height="1" as="geometry"/></mxCell><mxCell id="c39" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1500" y="1041" width="1" height="1" as="geometry"/></mxCell><mxCell id="c40" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;strokeWidth=1.5;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="Синхронный вызов (REST/HTTPS, SQL)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1510" y="1030" width="320" height="22" as="geometry"/></mxCell><mxCell id="c42" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1460" y="1071" width="1" height="1" as="geometry"/></mxCell><mxCell id="c43" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1500" y="1071" width="1" height="1" as="geometry"/></mxCell><mxCell id="c44" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#D9822B;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="c42" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="Асинхронное взаимодействие через Kafka" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1510" y="1060" width="320" height="22" as="geometry"/></mxCell><mxCell id="c46" value="UC1–UC8 — сценарии из раздела «Функциональные требования» ADR" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1460" y="1090" width="380" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
