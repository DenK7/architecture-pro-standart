      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;whiteSpace=wrap;" value="&lt;b&gt;[System Context] Банк «Стандарт» — открытие депозитов онлайн, MVP&lt;/b&gt;&lt;br&gt;C4, уровень 1: кто пользуется решением и с какими системами оно взаимодействует" vertex="1">
          <mxGeometry height="46" width="1800" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" value="&lt;b&gt;Новый клиент&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Ещё не клиент банка, приходит с сайта" vertex="1">
          <mxGeometry height="150" width="170" x="120" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" value="&lt;b&gt;Клиент банка&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Пользователь интернет-банка" vertex="1">
          <mxGeometry height="150" width="170" x="560" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" value="&lt;b&gt;Менеджер кол-центра&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Обзванивает клиентов по заявкам с сайта" vertex="1">
          <mxGeometry height="150" width="170" x="1000" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" value="&lt;b&gt;Сотрудник отделения&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Фронт-офис: идентифицирует нового клиента" vertex="1">
          <mxGeometry height="150" width="170" x="1290" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" value="&lt;b&gt;Менеджер бэк-офиса депозитов&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Ставки, обработка заявок" vertex="1">
          <mxGeometry height="150" width="170" x="1560" y="80" as="geometry" />
        </mxCell>
