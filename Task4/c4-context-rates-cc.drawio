<mxfile host="app.diagrams.net" type="device"><diagram id="C4 Context — ставки для кол-центров" name="C4 Context — ставки для кол-центров"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;[System Context] Банк «Стандарт» — передача ставок по депозитам в кол-центр банка и партнёрский кол-центр&lt;/b&gt;&lt;br&gt;C4, уровень 1. Показаны только элементы, которые затрагивает изменение" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1700" height="46" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Клиент&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Звонит уточнить условия депозита' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="760" y="80" width="170" height="150" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Оператор кол-центра банка&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Консультирует по ставкам' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="330" y="300" width="170" height="150" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Оператор партнёрского КЦ&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Консультирует при перегрузке КЦ банка' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="1200" y="300" width="170" height="150" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Система кол-центра банка&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Software System: CRM-платформа подрядчика, Java]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Новое: экран «Ставки по депозитам», ставки приходят из Kafka' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#2A9D8F;strokeColor=#1E7066;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="250" y="560" width="330" height="150" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Система партнёрского кол-центра&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[External System]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Забирает файл ставок с SFTP и показывает операторам' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#6B6B6B;strokeColor=#4D4D4D;fontColor=#ffffff;dashed=1;" vertex="1" parent="1"><mxGeometry x="1120" y="560" width="330" height="150" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Интеграционная платформа&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Software System: Kafka, Kafka Connect]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Новое: сервис выгрузки ставок в файл для партнёра' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#2A9D8F;strokeColor=#1E7066;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="680" y="820" width="330" height="150" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;SFTP-сервер&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Software System: DMZ банка]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Каталог партнёра, доступ по SSH-ключу и IP-allowlist' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1120" y="820" width="330" height="150" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;АБС&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Software System: Delphi, Oracle, PL/SQL]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Справочник ставок (MVP). Новое: признак публикации ставки' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#2A9D8F;strokeColor=#1E7066;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="680" y="1080" width="330" height="150" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Менеджер бэк-офиса депозитов&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Ведёт и утверждает ставки' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="200" y="1080" width="170" height="150" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;Сотрудник кредитования&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:10px"&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Параметры кредитного риска для ставок' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="400" y="1080" width="170" height="150" as="geometry"/></mxCell><mxCell id="c13" value="звонок&lt;br&gt;[телефон]" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;fontColor=#5A5A5A;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="415" y="170"/></Array></mxGeometry></mxCell><mxCell id="c14" value="звонок при перегрузке&lt;br&gt;КЦ банка [телефон]" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;fontColor=#5A5A5A;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1285" y="170"/></Array></mxGeometry></mxCell><mxCell id="c15" value="UC2: смотрит ставки" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;fontColor=#5A5A5A;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="UC4: смотрит ставки" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;fontColor=#5A5A5A;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="UC1: ведёт и&lt;br&gt;утверждает ставки" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;fontColor=#5A5A5A;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="285" y="1030"/><mxPoint x="640" y="1030"/><mxPoint x="640" y="1125"/></Array></mxGeometry></mxCell><mxCell id="c18" value="UC1: кредитный&lt;br&gt;риск" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;fontColor=#5A5A5A;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="UC1: изменения ставок&lt;br&gt;[Kafka Connect, CDC]" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#D9822B;fontColor=#D9822B;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="UC2: ставки&lt;br&gt;[Kafka]" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#D9822B;fontColor=#D9822B;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c8" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="415" y="895"/></Array></mxGeometry></mxCell><mxCell id="c21" value="UC3: файл ставок&lt;br&gt;[SFTP]" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;fontColor=#5A5A5A;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="UC4: забирает файл&lt;br&gt;[SFTP]" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;fontColor=#5A5A5A;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;Легенда&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1120" y="1030" width="300" height="24" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1120" y="1060" width="40" height="22" as="geometry"/></mxCell><mxCell id="c25" value="Новый элемент" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1170" y="1060" width="300" height="22" as="geometry"/></mxCell><mxCell id="c26" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#2A9D8F;strokeColor=#1E7066;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1120" y="1090" width="40" height="22" as="geometry"/></mxCell><mxCell id="c27" value="Существующий элемент, дорабатывается" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1170" y="1090" width="300" height="22" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1120" y="1120" width="40" height="22" as="geometry"/></mxCell><mxCell id="c29" value="Существующий элемент без изменений" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1170" y="1120" width="300" height="22" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#6B6B6B;strokeColor=#4D4D4D;fontColor=#ffffff;dashed=1;" vertex="1" parent="1"><mxGeometry x="1120" y="1150" width="40" height="22" as="geometry"/></mxCell><mxCell id="c31" value="Внешняя система" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1170" y="1150" width="300" height="22" as="geometry"/></mxCell><mxCell id="c32" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1120" y="1191" width="1" height="1" as="geometry"/></mxCell><mxCell id="c33" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1160" y="1191" width="1" height="1" as="geometry"/></mxCell><mxCell id="c34" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#5A5A5A;strokeWidth=1.5;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="Синхронный вызов (REST/HTTPS, SQL)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1170" y="1180" width="320" height="22" as="geometry"/></mxCell><mxCell id="c36" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1120" y="1221" width="1" height="1" as="geometry"/></mxCell><mxCell id="c37" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1160" y="1221" width="1" height="1" as="geometry"/></mxCell><mxCell id="c38" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#D9822B;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="Асинхронное взаимодействие через Kafka" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1170" y="1210" width="320" height="22" as="geometry"/></mxCell><mxCell id="c40" value="UC1–UC5 — сценарии из раздела «Функциональные требования» ADR" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1120" y="1240" width="380" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
