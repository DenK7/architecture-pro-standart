        <mxCell id="c19" value="&lt;b&gt;Export Scheduler&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[Component: Hosted Service, Quartz.NET]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Полный файл ежедневно до 08:00 и внеочередной при изменении ставок (через 5 мин)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" parent="1" vertex="1">
