        </mxCell>
        <mxCell id="c20" value="&lt;b&gt;Export Monitor&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[Component: OpenTelemetry]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Метрики выгрузок, алерт если файл старше 26 часов или загрузка не удалась" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" parent="1" vertex="1">
