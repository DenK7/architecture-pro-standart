        <mxCell id="c9" value="&lt;b&gt;Рабочее место оператора&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[Container: React (UI платформы КЦ)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Новое: виджет «Ставки по депозитам» с поиском по продукту и сроку" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#2A9D8F;strokeColor=#1E7066;fontColor=#ffffff;" parent="1" vertex="1">
